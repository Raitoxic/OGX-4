# ============================================
# VYRO-X — Human Intelligence. Agent Evolution.
# Environment Configuration Example
# ============================================

# Runtime environment: development | production
# In production, PostgreSQL DATABASE_URL and a >=32-char JWT_SECRET_KEY are strictly required (SQLite fallback disabled).
ENVIRONMENT=development

# Database Configuration
# Recommended Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://vyrox_user:strong_password@localhost:5432/vyrox
# Local Development Fallback (SQLite):
DATABASE_URL=sqlite:///./vyrox.db

# Security & Authentication (set a strong random secret in production)
JWT_SECRET_KEY=vyrox-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (requests per 60-second window per client IP)
AUTH_RATE_LIMIT_PER_MIN=30
ML_RETRAIN_RATE_LIMIT_PER_MIN=5

# Optional Live LLM Provider Configuration
# If both OPENAI_API_KEY and GEMINI_API_KEY are empty, VYRO-X runs in clearly labelled Deterministic Demo Mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Execution timing for observable real-time steps & mid-execution interrupt verification (seconds per stage)
DEMO_STEP_STAGE_DELAY_SEC=0.75
